<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses ke file & folder sensitif
    RewriteRule ^(\.env|\.env\..*|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|pint\.json|phpstan\.neon|eslint\.config\.js|vite\.config\.ts|tsconfig\.json|boost\.json|components\.json|pnpm-workspace\.yaml|.*\.md)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)/ - [F,L]

    # Arahkan semua request ke folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>